# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y rellena con tus valores reales

# Mensaje personalizado para el endpoint /api/v1/hola
MENSAJE_BIENVENIDA=Tu mensaje de bienvenida personalizado

# URL de conexión a MongoDB Atlas
# Obtén esta URL desde el dashboard de MongoDB Atlas:
# 1. Ve a tu cluster → Connect → Connect your application
# 2. Copia la cadena de conexión y reemplaza <password> con tu contraseña real
# 3. Reemplaza <dbname> con el nombre de tu base de datos
MONGODB_URI=obtener_desde_mongodb_atlas_dashboard

# Clave secreta para firmar tokens JWT
# IMPORTANTE: Usa una cadena aleatoria y segura en producción
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=genera_una_clave_secura_aleatoria
